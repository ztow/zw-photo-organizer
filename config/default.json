{
  "name": "赵兄的智能照片整理",
  "version": "2.0.0",
  "description": "复制式智能照片整理：三级日期识别 + 台账管理 + 按台账清理",
  "photo_extensions": [
    ".jpg",
    ".jpeg",
    ".png",
    ".cr2",
    ".nef",
    ".arw",
    ".heic",
    ".heif",
    ".mov",
    ".mp4"
  ],
  "date_patterns": {
    "filename": [
      "\\d{4}[_-]?\\d{2}[_-]?\\d{2}"
    ],
    "directory": [
      "\\d{4}年\\d{1,2}月\\d{1,2}日",
      "\\d{4}[_-]?\\d{1,2}[_-]?\\d{1,2}"
    ]
  },
  "max_parent_depth": 3,
  "use_mtime": false,
  "mtime_note": "修改时间不可靠（可能是复制时间或被其它操作改动），已停用",
  "target_folder": "整理后照片",
  "unsure_handling": "识别不了日期的不复制、不删除，留在原处，记入台账",
  "ledger_json": "整理台账.json",
  "ledger_md": "整理台账.md",
  "directory_structure": {
    "year": "{year}",
    "month": "{year}_{month}",
    "day": "{year}_{month}_{day}"
  }
}
